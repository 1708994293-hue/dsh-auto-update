{
  "name": "@sueleven/dsh-auto-update",
  "version": "1.0.0",
  "description": "DSH 插件：每次打开 DeepSeek Harness 时自动检查已下载并启用的插件有没有新版本，在界面上列出并询问是否更新，确认后更新到最新版。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "auto-update",
    "plugin-manager"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/update.mjs",
    "test:check": "node lib/update.mjs --check --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1708994293-hue/dsh-auto-update.git"
  },
  "homepage": "https://github.com/1708994293-hue/dsh-auto-update#readme",
  "bugs": {
    "url": "https://github.com/1708994293-hue/dsh-auto-update/issues"
  }
}
